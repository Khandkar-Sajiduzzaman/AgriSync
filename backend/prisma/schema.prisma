generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Prisma migrations (bypasses Supabase pooler)
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  buyer
  farmer
  delivery_man
  admin
}


enum AccountStatus {
  active
  suspended
  deactivated
}

enum OrderStatus {
  pending          // Buyer placed order, waiting farmer confirmation
  confirmed        // Farmer accepted the order
  processing       // Farmer is preparing the items
  awaiting_delivery
  shipped          // Items handed to delivery man
  out_for_delivery // Delivery man is on the way
  delivered        // Buyer received the items
  cancelled        // Cancelled by buyer or farmer
  refunded         // Payment refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  cash_on_delivery
  online_transfer
  mobile_banking
  card
}

enum NegotiationStatus {
  pending
  accepted
  rejected
  countered
  expired
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum NotificationType {
  order_update
  message
  negotiation
  follow
  review
  promotion
  system
  price_drop
  stock_alert
}

enum InventoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitType {
  kg
  gram
  liter
  piece
  bunch
  dozen
  bag
  box
}
enum ModerationStatus {
  pending
  approved
  rejected
}

enum DeliveryType {
  normal
  instant
  same_day
  scheduled
}

enum DeliveryRequestStatus {
  pending
  accepted
  rejected
  cancelled
  expired
}
// =============================================================================
// USER & ROLE PROFILES
// =============================================================================
// Single User table with role enum + separate profile tables for each role.
// This is the Prisma way of handling inheritance (class table inheritance).
// Matches the class diagram: User is the base; Admin, Buyer, Farmer,
// DeliveryMan are specializations.
// =============================================================================

  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  password                  String
  name                      String
  role                      Role
  accountStatus             AccountStatus            @default(active)
  phone                     String?
  address                   String?
  bio                       String?
  profileImage              String?
  latitude                  Float?
  longitude                 Float?
  division                  String?
  district                  String?
  upazila                   String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  adminActions              AdminActionLog[]
  buyerProfile              BuyerProfile?
  cartItems                 CartItem[]
  deliveryManProfile        DeliveryManProfile?
  DeliveryRequest           DeliveryRequest[]
  farmerProfile              FarmerProfile?
  following                 Follow[]                 @relation("UserFollowing")
  followers                 Follow[]                 @relation("UserFollowers")
  inventoryRequests         InventoryChangeRequest[] @relation("InventoryRequestFarmer")
  reviewedInventoryRequests InventoryChangeRequest[] @relation("InventoryRequestReviewer")

  // --- Relations: Wishlist & Follow ---
  wishlist      Wishlist[]
  following     Follow[]    @relation("UserFollowing")
  followers     Follow[]    @relation("UserFollowers")

  // --- Relations: Orders ---
  ordersAsBuyer   Order[]   @relation("OrderBuyer")
  ordersAsFarmer  Order[]   @relation("OrderFarmer")

  // --- Relations: Delivery ---
  assignedDeliveries Order[] @relation("OrderDeliveryMan")

    // NEW RELATION: delivery requests sent to this delivery man
  deliveryRequests   DeliveryRequest[] @relation("DeliveryManRequests")

  // --- Relations: Chat ---
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageReceiver")

  // --- Relations: Reviews ---
  reviewsGiven     Review[]  @relation("ReviewAuthor")

  // --- Relations: Negotiation ---
  negotiationsAsBuyer  Negotiation[] @relation("NegotiationBuyer")
  negotiationsAsFarmer Negotiation[] @relation("NegotiationFarmer")

  // --- Relations: Notifications ---
  notifications    Notification[]

  // --- Relations: Cart ---
  cartItems        CartItem[]

  // --- Relations: Product Votes ---
  productVotes     ProductVote[]

  // --- Relations: Admin ---
  adminActions     AdminActionLog[]
  reportsGenerated SalesReport[]
  messagesReceived          Message[]                @relation("MessageReceiver")
  messagesSent              Message[]                @relation("MessageSender")
  negotiationsAsBuyer       Negotiation[]            @relation("NegotiationBuyer")
  negotiationsAsFarmer      Negotiation[]            @relation("NegotiationFarmer")
  notifications             Notification[]
  ordersAsBuyer             Order[]                  @relation("OrderBuyer")
  assignedDeliveries        Order[]                  @relation("OrderDeliveryMan")
  ordersAsFarmer            Order[]                  @relation("OrderFarmer")
  products                  Product[]
  productVotes              ProductVote[]
  promotionRequests         Promotion[]              @relation("PromotionFarmer")
  reviewedPromotions        Promotion[]              @relation("PromotionReviewer")
  reviewsGiven              Review[]                 @relation("ReviewAuthor")
  reportsGenerated          SalesReport[]
  wishlist                  Wishlist[]

  @@index([email])
  @@index([role])
  @@index([accountStatus])
  @@index([division, district])
}

model FarmerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  farmName           String?
  farmLocation       String?
  farmDescription    String?
  farmLatitude       Float?
  farmLongitude      Float?
  averageRating      Float              @default(0)
  totalReviews       Int                @default(0)
  verificationStatus VerificationStatus @default(unverified)
  verificationDocUrl String?
  idCardUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deliveryZones      DeliveryZone[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model BuyerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  rewardPoints Int     @default(0)
  location     String?
  latitude     Float?
  longitude    Float?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryManProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType      String? // e.g., "Motorcycle", "Van", "Truck"
  licenseNumber    String?
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationUpdate DateTime?  //When was gps last Updated
  isAvailable      Boolean @default(true)
  // NEW: area preferences and capacity
  preferredAreas   String[]
  maxOrders        Int     @default(3)
}

// =============================================================================
// CATEGORY
// =============================================================================
// Replaces free-text category with a proper taxonomy.
// Supports sub-categories via self-relation (parent/children).
// For NOW the frontend still sends free-text `category` — store that in
// Product.legacyCategory. When you migrate to structured categories, use
// Product.categoryId instead.
// =============================================================================
  id                 String    @id @default(uuid())
  userId             String    @unique
  vehicleType        String?
  licenseNumber      String?
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?
  isAvailable        Boolean   @default(true)
  preferredAreas     String[]
  maxOrders          Int       @default(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  imageUrl     String?
  parentId     String?
  createdAt    DateTime      @default(now())
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  marketPrices MarketPrice[]
  products     Product[]

  @@index([slug])
}

model Product {
  id                      String                   @id @default(uuid())
  name                    String
  description             String?
  price                   Decimal                  @db.Decimal(12, 2)
  stock                   Int                      @default(0)
  unit                    UnitType                 @default(kg)
  categoryId              String?
  legacyCategory          String?
  origin                  String?
  originDetails           String?
  nutritionInfo           String?
  images                  String[]
  isAvailable             Boolean                  @default(true)
  isApproved              Boolean                  @default(true)
  approvedAt              DateTime?
  approvedBy              String?
  isRemoved               Boolean                  @default(false)
  removalReason           String?
  averageRating           Float                    @default(0)
  totalReviews            Int                      @default(0)
  totalVotes              Int                      @default(0)
  farmerId                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cartItems               CartItem[]
  inventoryChangeRequests InventoryChangeRequest[]
  inventoryLogs           InventoryLog[]
  negotiations            Negotiation[]
  orderItems              OrderItem[]
  categoryEntity          Category?                @relation(fields: [categoryId], references: [id])
  farmer                  User                     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  promotions              ProductPromotion[]
  promotionRequests       Promotion[]
  productViews            ProductView[]
  productVotes            ProductVote[]
  reviews                 Review[]
  wishlistedBy            Wishlist[]

  @@index([farmerId])
  @@index([legacyCategory])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isApproved])
  @@index([averageRating])
  @@index([createdAt])
  @@index([price])
}

model ProductVote {
  id        String   @id @default(uuid())
  userId    String
  productId String
  value     Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, createdAt])
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  buyerId           String
  farmerId          String
  status            OrderStatus          @default(pending)
  paymentStatus     PaymentStatus        @default(pending)
  paymentMethod     PaymentMethod        @default(cash_on_delivery)
  subtotal          Decimal              @db.Decimal(12, 2)
  totalAmount       Decimal              @db.Decimal(12, 2)
  deliveryFee       Decimal?             @db.Decimal(12, 2)
  discountAmount    Decimal?             @db.Decimal(12, 2)
  deliveryAddress   String
  deliveryNotes     String?
  cancelledAt       DateTime?
  cancelledBy       String?
  deliveryManId     String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // NEW FIELDS FOR DELIVERY SYSTEM
  deliveryType    DeliveryType  @default(normal)
  deliveryCity    String?
  deliveryArea    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  reviews         Review[]
  trackingUpdates DeliveryTracking[]
  deliveryRequests DeliveryRequest[]
  deliveryType      DeliveryType         @default(normal)
  deliveryCity      String?
  deliveryArea      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  DeliveryRequest   DeliveryRequest[]
  trackingUpdates   DeliveryTracking[]
  buyer             User                 @relation("OrderBuyer", fields: [buyerId], references: [id])
  deliveryMan       User?                @relation("OrderDeliveryMan", fields: [deliveryManId], references: [id])
  farmer            User                 @relation("OrderFarmer", fields: [farmerId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  reviews           Review[]

  @@index([buyerId])
  @@index([farmerId])
  @@index([deliveryManId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  unit        UnitType @default(kg)
  productName String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  changedBy String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model DeliveryTracking {
  id        String   @id @default(uuid())
  orderId   String
  latitude  Float
  longitude Float
  status    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model DeliveryZone {
  id        String        @id @default(uuid())
  farmerId  String
  name      String
  location  String?
  latitude  Float?
  longitude Float?
  radiusKm  Float?
  createdAt DateTime      @default(now())
  farmer    FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
}

model Review {
  id                 String           @id @default(uuid())
  rating             Int              @db.SmallInt
  comment            String?
  authorId           String
  productId          String
  orderId            String
  isVerifiedPurchase Boolean          @default(false)
  isFlagged          Boolean          @default(false)
  fraudScore         Float?
  fraudReasons       String[]
  moderationStatus   ModerationStatus @default(pending)
  moderatedById      String?
  moderatedAt        DateTime?
  moderationNote     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  author             User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  order              Order            @relation(fields: [orderId], references: [id])
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([authorId, productId, orderId])
  @@index([productId])
  @@index([authorId])
  @@index([orderId])
  @@index([createdAt])
  @@index([isFlagged])
  @@index([moderationStatus])
}

model Negotiation {
  id           String               @id @default(uuid())
  productId    String
  buyerId      String
  farmerId     String
  offerPrice   Decimal              @db.Decimal(12, 2)
  status       NegotiationStatus    @default(pending)
  counterPrice Decimal?             @db.Decimal(12, 2)
  message      String?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  buyer        User                 @relation("NegotiationBuyer", fields: [buyerId], references: [id])
  farmer       User                 @relation("NegotiationFarmer", fields: [farmerId], references: [id])
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  history      NegotiationHistory[]

  @@index([productId])
  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
}

model NegotiationHistory {
  id            String      @id @default(uuid())
  negotiationId String
  senderId      String
  offerPrice    Decimal     @db.Decimal(12, 2)
  message       String?
  createdAt     DateTime    @default(now())
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@index([createdAt])
}

model Message {
  id            String   @id @default(uuid())
  content       String
  isRead        Boolean  @default(false)
  attachmentUrl String?
  senderId      String
  receiverId    String
  productId     String?
  orderId       String?
  createdAt     DateTime @default(now())
  receiver      User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model InventoryChangeRequest {
  id              String                 @id @default(uuid())
  farmerId        String
  productId       String
  currentStock    Int
  requestedStock  Int
  reason          String
  status          InventoryRequestStatus @default(PENDING)
  reviewedById    String?
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  farmer          User                   @relation("InventoryRequestFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy      User?                  @relation("InventoryRequestReviewer", fields: [reviewedById], references: [id])

  @@index([farmerId])
  @@index([productId])
  @@index([status])
}

model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  oldStock  Int
  newStock  Int
  change    Int
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Promotion {
  id                String             @id @default(uuid())
  farmerId          String?
  farmer            User?              @relation("PromotionFarmer", fields: [farmerId], references: [id], onDelete: SetNull)
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  title             String
  description       String?            @db.Text
  discountPercent   Int?
  discountAmount    Decimal?           @db.Decimal(12, 2)
  minOrderAmount    Decimal?           @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean            @default(true)
  status            PromotionStatus    @default(PENDING)
  reviewedById      String?
  reviewedBy        User?              @relation("PromotionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  rejectionReason   String?            @db.Text
  createdAt         DateTime           @default(now())
  productPromotions ProductPromotion[]

  @@index([farmerId])
  @@index([productId])
  @@index([status])
  @@index([isActive])
  @@index([startDate, endDate])
}

model ProductPromotion {
  id          String    @id @default(uuid())
  productId   String
  promotionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([productId, promotionId])
}

model ProductComparison {
  id        String           @id @default(uuid())
  buyerId   String
  name      String?
  createdAt DateTime         @default(now())
  items     ComparisonItem[]
}

model ComparisonItem {
  id           String            @id @default(uuid())
  comparisonId String
  productId    String
  comparison   ProductComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
}

model ProductView {
  id        String   @id @default(uuid())
  buyerId   String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([productId])
  @@index([createdAt])
}

model MarketPrice {
  id           String   @id @default(uuid())
  categoryId   String
  averagePrice Decimal  @db.Decimal(12, 2)
  minPrice     Decimal  @db.Decimal(12, 2)
  maxPrice     Decimal  @db.Decimal(12, 2)
  sampleSize   Int
  date         DateTime
  createdAt    DateTime @default(now())
  category     Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([date])
}

model SalesReport {
  id           String   @id @default(uuid())
  adminId      String
  title        String
  period       String
  totalOrders  Int
  totalSales   Int
  totalRevenue Decimal  @db.Decimal(12, 2)
  data         Json?
  createdAt    DateTime @default(now())
  admin        User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([period])
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model DeliveryRequest {
  id              String                @id @default(uuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryManId   String
  deliveryMan     User                  @relation("DeliveryManRequests", fields: [deliveryManId], references: [id], onDelete: Cascade)
  status          DeliveryRequestStatus @default(pending)
  requestType     DeliveryType
  message         String?
  createdAt       DateTime              @default(now())
  respondedAt     DateTime?

  @@index([deliveryManId, status])
  @@index([orderId])
}
  id            String                @id
  orderId       String
  deliveryManId String
  status        DeliveryRequestStatus @default(pending)
  requestType   DeliveryType
  message       String?
  createdAt     DateTime              @default(now())
  respondedAt   DateTime?
  User          User                  @relation(fields: [deliveryManId], references: [id], onDelete: Cascade)
  Order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryManId, status])
  @@index([orderId])
}

enum Role {
  buyer
  farmer
  delivery_man
  admin
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum OrderStatus {
  pending
  confirmed
  processing
  awaiting_delivery
  shipped
  out_for_delivery
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  cash_on_delivery
  online_transfer
  mobile_banking
  card
}

enum NegotiationStatus {
  pending
  accepted
  rejected
  countered
  expired
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum NotificationType {
  order_update
  message
  negotiation
  follow
  review
  promotion
  system
  price_drop
  stock_alert
}

enum InventoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitType {
  kg
  gram
  liter
  piece
  bunch
  dozen
  bag
  box
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum DeliveryRequestStatus {
  pending
  accepted
  rejected
  cancelled
  expired
}

enum DeliveryType {
  normal
  instant
  same_day
  scheduled
}
